POSTGRES_USER=cyber_dashboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cyber_dashboard

DB_HOST=db
DB_PORT=5432

API_NAME=Cyber Dashboard API
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO

LOG_LEVEL=INFO

CORRELATOR_BATCH_SIZE=500
CORRELATOR_POLL_INTERVAL_SECONDS=10
CORRELATOR_LOG_LEVEL=INFO
CORRELATOR_COMPUTE_AVERAGE_PROCESSING_TIME=false

OGO_BASE_URL=https://api.ogosecurity.example
SERENICITY_BASE_URL=https://api.control.serenicity.example

CYBER_DASHBOARD_SECRET_KEY_FILE=/run/secrets/cyber_dashboard_secret_key
CYBER_DASHBOARD_SECRET_KEY=

CYBER_DASHBOARD_API_IMAGE=registry.example.com/cyber-dashboard-api:latest
CYBER_DASHBOARD_SCHEDULER_IMAGE=registry.example.com/cyber-dashboard-scheduler:latest
CYBER_DASHBOARD_COMMON_IP_IMAGE=registry.example.com/cyber-dashboard-common-ip:latest
CYBER_DASHBOARD_FRONTEND_IMAGE=registry.example.com/cyber-dashboard-frontend:latest
CYBER_DASHBOARD_MIGRATE_IMAGE=registry.example.com/cyber-dashboard-migrate:latest
